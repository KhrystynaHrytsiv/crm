{
    "name": "crm",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "main.js",
    "scripts": {
        "dev": "rimraf dist && tsc-watch --onSuccess \"npm run watch:server\"",
        "watch:server": "tsx src/main.ts --watch",
        "typecheck": "tsc --noEmit -p .",
        "build": "npm run typecheck && esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist/main.js",
        "start": "node --enable-source-maps dist/main.js"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "joi": "^18.3.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.9.5",
        "pino": "^10.4.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/dotenv": "^8.2.3",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/swagger-ui-express": "^4.1.8",
        "esbuild": "^0.25.12",
        "rimraf": "^6.1.3",
        "tsc-watch": "^7.2.1",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=24"
    }
}
