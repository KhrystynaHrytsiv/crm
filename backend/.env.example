# MongoDB connection string (Atlas or any MongoDB 5+)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=4000

# long random strings, different for each secret (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=<random-string>
JWT_REFRESH_SECRET=<random-string>
JWT_ACTIVATE_SECRET=<random-string>
JWT_RECOVERY_SECRET=<random-string>

JWT_ACCESS_LIFETIME=1h
JWT_REFRESH_LIFETIME=90m
JWT_ACTIVATE_LIFETIME=30m
JWT_RECOVERY_LIFETIME=30m

# public address of the frontend: used for CORS and in activation links
FRONTEND_URL=http://localhost:3000

DNS_SERVERS=8.8.8.8,8.8.4.4

